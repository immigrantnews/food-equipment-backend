{
  "manifest_version": 3,
  "name": "IndMart — Оценка оборудования",
  "version": "1.0.0",
  "description": "Бесплатная оценка пищевого оборудования прямо на Авито",
  "permissions": ["storage", "activeTab", "notifications"],
  "host_permissions": ["https://www.avito.ru/*", "https://avito.ru/*", "https://youla.ru/*", "https://www.youla.ru/*"],
  "content_scripts": [{
    "matches": ["https://www.avito.ru/*", "https://avito.ru/*", "https://youla.ru/*", "https://www.youla.ru/*"],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_popup": "popup.html",
    "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}
  }
}
